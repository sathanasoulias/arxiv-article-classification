# Dataset and derived data are large and regenerable, and live outside this folder.
# Exception: data/splits holds the sampled arXiv ids, which are small and ARE
# committed — they pin the exact sample so results stay reproducible even though
# the Kaggle dataset is re-published monthly.
data/*
!data/splits/
*.jsonl
*.parquet

# Results are committed so the report's numbers are traceable.
*.json
!reports/*.json

# Reference papers kept locally, not redistributed
papers/
*.pdf

# Model artifacts
models/
checkpoints/
*.bin
*.safetensors
*.ckpt
*.pt

# Cached embeddings
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# HuggingFace / W&B caches
.cache/
wandb/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
